# Solo Pool Ports
STRATUM_PORT=3333
WEB_PORT=8080

# Difficulty & Vardiff Settings
DEFAULT_DIFF=256
ENABLE_VARDIFF=true
MIN_DIFF=16
MAX_DIFF=1048576
VARDIFF_TARGET_SHARES=12

# Node RPC Settings (DigiByte / Auroracoin / Bitcoin)
RPC_HOST=127.0.0.1
RPC_PORT=8332
RPC_USER=bitcoinrpc
RPC_PASSWORD=rpcpassword
RPC_NETWORK=mainnet
RPC_ALGO=sha256d

# ZMQ Notification Port (Optional for instant block updates)
ZMQ_HOST=127.0.0.1
ZMQ_PORT=28332

# Pool Identity & Wallet Payout
POOL_NAME="zpool proxy SHA-256 Solo Pool"
COIN_SYMBOL=BTC
COINBASE_TEXT="/zpool-proxy/"
POOL_FEE_PERCENT=0.0
POOL_FEE_ADDRESS=""
WALLET_ADDRESS="AWPuDcCymof8BRF9cfkxnLqmhn7ZPVPjEr"

# ntfy Block Found Notification
NTFY_SERVER="http://192.168.1.250:18080"
NTFY_TOPIC="zpool-proxy-blocks"
NTFY_USER="user"
NTFY_PASSWORD="pass"
