# Solo Pool Ports
STRATUM_PORT=3333
WEB_PORT=8080

# Difficulty & Vardiff Settings
# DEFAULT_DIFF: Set fixed difficulty (e.g. 1024 or 4096)
DEFAULT_DIFF=1024
# ENABLE_VARDIFF: Set to false to LOCK difficulty to DEFAULT_DIFF (no auto-adjusting)
ENABLE_VARDIFF=false
MIN_DIFF=64
MAX_DIFF=1048576
VARDIFF_TARGET_SHARES=12

# Node RPC Settings (DigiByte / Auroracoin / Bitcoin)
RPC_HOST=127.0.0.1
RPC_PORT=8332
RPC_USER=bitcoinrpc
RPC_PASSWORD=rpcpassword
RPC_NETWORK=mainnet
RPC_ALGO=sha256d

# ZMQ Notification Port (Optional for instant block updates)
ZMQ_HOST=127.0.0.1
ZMQ_PORT=28332

# Pool Identity & Payout
POOL_NAME="ntpool SHA-256 Solo Pool"
COINBASE_TEXT="/ntpool/"
POOL_FEE_PERCENT=0.0
POOL_FEE_ADDRESS=""
